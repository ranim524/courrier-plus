# --- Database ---
DATABASE_URL=postgresql+psycopg2://courrier_plus:courrier_plus_dev_pw@localhost:5432/courrier_plus

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET=change-me-to-a-different-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
ACCESS_TOKEN_EXPIRATION_DAYS=30

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Resend (email) ---
# Leave RESEND_API_KEY empty to run in development/mock email mode.
# onboarding@resend.dev works without a verified domain, but Resend then only
# delivers to the email address of the Resend account itself. Switch to an
# address on your own verified domain once you add one.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Courrier+

# --- Payment ---
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_SECRET=
# Pricing is dynamic (PDF page count -> estimated weight -> tariff bracket),
# see app/services/pricing_service.py. No fixed price env var anymore.
CURRENCY=TND

# --- File uploads ---
# STORAGE_PROVIDER=local writes PDFs to UPLOAD_DIR on the local filesystem (dev default).
# STORAGE_PROVIDER=database stores them as bytes in this same Postgres database
# (document_blobs table) -- no extra account needed, good for production without
# a separate object-storage service.
# STORAGE_PROVIDER=r2 stores them in a Cloudflare R2 bucket instead -- fill in
# the R2_* values below (from your R2 bucket's "Manage API Tokens" page).
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- External delivery carrier webhook ---
# Shared secret an external carrier's own platform must send back
# (X-Webhook-Secret header) to POST /api/webhooks/delivery/deposited when
# their courier places a letter in the recipient's mailbox. Leave empty
# until a real external carrier (DeliveryProvider.provider_type=EXTERNAL_CARRIER,
# api_enabled=true) is configured -- an empty value rejects every webhook call.
DELIVERY_WEBHOOK_SECRET=

# --- Admin bootstrap (used only by scripts/create_admin.py) ---
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# --- Misc ---
ENVIRONMENT=development
LOG_LEVEL=INFO

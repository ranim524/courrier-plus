# --- Database ---
DATABASE_URL=postgresql+psycopg2://courrier_plus:courrier_plus_dev_pw@localhost:5432/courrier_plus

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET=change-me-to-a-different-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
ACCESS_TOKEN_EXPIRATION_DAYS=30

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Resend (email) ---
# Leave RESEND_API_KEY empty to run in development/mock email mode.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@courrierplus.tn
RESEND_FROM_NAME=Courrier+

# --- Payment ---
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_SECRET=
LETTER_PRICE=15.00
CURRENCY=TND

# --- File uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --- Admin bootstrap (used only by scripts/create_admin.py) ---
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# --- Misc ---
ENVIRONMENT=development
LOG_LEVEL=INFO
